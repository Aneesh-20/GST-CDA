# -------------------------------------------------------------
# GST CDA Environment Configuration Template
# Tagline: GST Made Simple. Business Made Easy.
# -------------------------------------------------------------

# Application Runtime
NODE_ENV=development
PORT=3000
APP_SECRET=changeme-super-secret-key-32-chars-minimum

# Database (Default: local SQLite database; replace with PostgreSQL if using Docker)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gst_cda?schema=public"

# GSP Integration Layer Safeguards
# Keep ENABLE_LIVE_GSP=false until official provider agreement, credentials, and certification are in place
ENABLE_LIVE_GSP=false
GSP_ENVIRONMENT=SANDBOX
GSP_BASE_URL="https://sandbox.gsp-gateway.in/api/v1"
GSP_CLIENT_ID=""
GSP_CLIENT_SECRET=""

# Grounded GST Copilot (Optional AI Assistant Server Key)
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Storage Settings (Local file vault by default)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage/vault"

